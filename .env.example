# ==============================================================================
# Database Configuration (TiDB Cloud Serverless / MySQL)
# ==============================================================================
# TiDB Cloud does NOT need an API key! It connects using a standard MySQL connection string.
# In your TiDB Cloud dashboard: Click "Connect" -> Choose "Prisma" or "General" -> Copy the string.
#
# Format:
# DATABASE_URL="mysql://<USER_PREFIX>.<ROOT_USER>:<PASSWORD>@<HOST>:4000/<DATABASE>?sslaccept=strict"
#
# Example with actual TiDB Cloud structure:
# DATABASE_URL="mysql://2xxxxxx.root:YourPassword123@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/tap2read?sslaccept=strict"
DATABASE_URL="mysql://<username>:<password>@<host>:4000/<database_name>?sslaccept=strict"

# NextAuth Configuration
NEXTAUTH_SECRET="generate-a-secure-random-secret-for-production"
NEXTAUTH_URL="https://your-production-domain.vercel.app"

# Cloudinary CDN Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# FormSubmit Configuration (Inquiries / Contact)
FORMSUBMIT_EMAIL="kristanmartinito2003@gmail.com"

# Optional Email Fallback (Nodemailer)
GMAIL_USER="your-gmail@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
CONTACT_RECEIVER_EMAIL="email-that-receives-messages@gmail.com"
