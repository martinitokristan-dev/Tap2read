# ==============================================================================
# Database Configuration
# ==============================================================================
# --- OPTION 1: Local Development (XAMPP / MySQL on localhost) ---
# Use this in your local .env so testing will NOT affect your live database!
DATABASE_URL="mysql://root:@127.0.0.1:3306/tap2read"

# --- OPTION 2: Live Production (TiDB Cloud Serverless) ---
# Input this into your Vercel Project Settings -> Environment Variables:
# DATABASE_URL="mysql://<USER_PREFIX>.<ROOT_USER>:<PASSWORD>@<HOST>:4000/<DATABASE>?sslaccept=strict"
# Example:
# DATABASE_URL="mysql://2xxxxxx.root:YourPassword123@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/tap2read?sslaccept=strict"

# NextAuth Configuration
NEXTAUTH_SECRET="generate-a-secure-random-secret-for-production"
NEXTAUTH_URL="https://your-production-domain.vercel.app"

# Cloudinary CDN Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# FormSubmit Configuration (Inquiries / Contact)
# You can use your email OR FormSubmit's permanent token hash (prevents activation emails):
FORMSUBMIT_EMAIL="5e291b5d57d61cc10d531e140118a814"

# Optional Email Fallback (Nodemailer)
GMAIL_USER="your-gmail@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
CONTACT_RECEIVER_EMAIL="bobis.sb@stud.pnu.edu.ph"
